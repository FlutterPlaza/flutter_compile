<idea-plugin>
    <id>com.flutterplaza.fluttercompile</id>
    <name>Flutter Compile</name>
    <vendor email="dev@flutterplaza.com" url="https://www.flutterplaza.com">FlutterPlaza</vendor>

    <description><![CDATA[
        <p>Manage multiple Flutter SDK versions from Android Studio or IntelliJ IDEA.
        Install, switch, pin, and remove SDKs without leaving the IDE.</p>

        <h2>Features</h2>

        <h3>SDK Manager</h3>
        <ul>
            <li>Tree view with status icons — green check (active), package (installed), plugin (contributor build)</li>
            <li>Toolbar combo box for quick SDK switching from the main toolbar</li>
            <li>Right-click context menu: Set as Global, Pin to Project, Open SDK Folder, Remove SDK</li>
            <li>Double-click any SDK to set it as the global default</li>
            <li>Install new SDKs by version number or channel (stable, beta, etc.)</li>
        </ul>

        <h3>Doctor</h3>
        <ul>
            <li>Grouped diagnostic checks: Required Tools, Engine Tools, Configuration, Environments</li>
            <li>Pass/fail/warning icons with summary counts per category (e.g. 3/4 OK)</li>
            <li>Inline details: install paths, error messages, missing remotes</li>
        </ul>

        <h3>Engine Builds</h3>
        <ul>
            <li>Engine path, source status, and host CPU at a glance</li>
            <li>Build targets with disk sizes for Flutter engine contributors</li>
        </ul>

        <h3>Automatic Refresh</h3>
        <ul>
            <li>File watcher detects <code>.flutter-version</code> changes and refreshes the SDK tree</li>
            <li>CLI availability check on startup — shows install instructions if missing</li>
            <li>Flutter SDK path in project settings updates automatically on switch</li>
        </ul>

        <h2>Getting Started</h2>
        <ol>
            <li>Install the CLI: <code>dart pub global activate flutter_compile</code></li>
            <li>Make sure <code>~/.pub-cache/bin</code> is in your <code>PATH</code></li>
            <li>Open a Flutter project — the Flutter Compile tool window appears in the bottom panel</li>
        </ol>

        <p>Licensed under the BSD 3-Clause License. See
        <a href="https://github.com/flutterplaza/flutter_compile/blob/main/extensions/intellij/LICENSE">LICENSE</a>
        for details.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Dart</depends>
    <depends>io.flutter</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Flutter Compile"
                    anchor="bottom"
                    secondary="true"
                    icon="/icons/flutterCompile.svg"
                    factoryClass="com.flutterplaza.fluttercompile.toolwindow.FlutterCompileToolWindowFactory"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.flutterplaza.fluttercompile.settings.FlutterCompileConfigurable"
                id="com.flutterplaza.fluttercompile.settings"
                displayName="Flutter Compile"/>

        <applicationService
                serviceImplementation="com.flutterplaza.fluttercompile.settings.FlutterCompileSettings"/>

        <notificationGroup id="Flutter Compile"
                           displayType="BALLOON"/>

        <postStartupActivity
                implementation="com.flutterplaza.fluttercompile.startup.CliAvailabilityChecker"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <localTerminalCustomizer
                implementation="com.flutterplaza.fluttercompile.terminal.SdkTerminalCustomizer"/>
    </extensions>

    <projectListeners>
        <listener class="com.flutterplaza.fluttercompile.listeners.VersionFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="FlutterCompile.InstallSdk"
                class="com.flutterplaza.fluttercompile.actions.InstallSdkAction"
                text="Install Flutter SDK..."
                description="Install a Flutter SDK version via flutter_compile">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.Doctor"
                class="com.flutterplaza.fluttercompile.actions.DoctorAction"
                text="Flutter Compile Doctor"
                description="Run flutter_compile doctor">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.RemoveSdk"
                class="com.flutterplaza.fluttercompile.actions.RemoveSdkAction"
                text="Remove Flutter SDK..."
                description="Remove an installed Flutter SDK">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.PinSdkToProject"
                class="com.flutterplaza.fluttercompile.actions.PinSdkToProjectAction"
                text="Pin Flutter SDK to Project..."
                description="Pin a Flutter SDK to the current project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.UnpinSdkFromProject"
                class="com.flutterplaza.fluttercompile.actions.UnpinSdkFromProjectAction"
                text="Unpin Flutter SDK from Project"
                description="Remove the Flutter SDK pin from the current project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.OpenSdkFolder"
                class="com.flutterplaza.fluttercompile.actions.OpenSdkFolderAction"
                text="Open Flutter SDK Folder..."
                description="Open an SDK installation folder in the file manager">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.Refresh"
                class="com.flutterplaza.fluttercompile.actions.RefreshAction"
                text="Refresh Flutter Compile"
                description="Refresh all Flutter Compile panels">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.SwitchSdk"
                class="com.flutterplaza.fluttercompile.actions.SwitchSdkComboBoxAction"
                text="Flutter SDK"
                description="Switch the active Flutter SDK version">
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <add-to-group group-id="NavBarToolBar" anchor="last"/>
        </action>

        <action id="FlutterCompile.CodePushLogin"
                class="com.flutterplaza.fluttercompile.actions.CodePushLoginAction"
                text="Code Push Login"
                description="Login to Code Push server">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.CodePushRelease"
                class="com.flutterplaza.fluttercompile.actions.CodePushReleaseAction"
                text="Code Push: Create Release"
                description="Upload a baseline release">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.CodePushPatch"
                class="com.flutterplaza.fluttercompile.actions.CodePushPatchAction"
                text="Code Push: Create Patch"
                description="Upload a code push patch">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="FlutterCompile.CodePushRollback"
                class="com.flutterplaza.fluttercompile.actions.CodePushRollbackAction"
                text="Code Push: Rollback"
                description="Deactivate a patch">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
